-- Records, arrays, type shapes, and callback fields keep their structure.
export type Job = {
  name: string,
  options: {
    labels: {string},
    metadata: {[string]: string},
  },
}

let settings = {
  name = "worker",
  retry = {
    attempts = 3,
    delays = [1, 2, 5],
  },
  metadata = {},
}

let handlers = {
  run = (def(job: Job) -> string:
    if #job.options.labels > 0:
      return job.name
    return "idle"
  ),
}

let jobs: {Job} = [
  {
    name = settings.name,
    options = {
      labels = ["scheduled", "daily"],
      metadata = settings.metadata,
    },
  },
]

for _, job in ipairs(jobs):
  print(handlers.run(job))
