-- Luau function types keep ->; definitions use -> for the return type too.
export type Mapper<T, U> = (T) -> U

def map<T, U>(items: {T}, transform: Mapper<T, U>) -> {U}:
  let result: {U} = []
  for i, item in items:
    result[i] = transform(item)
  return result

let doubled = map([1, 2, 3], def(value: number) -> number:
  return value * 2
)

-- Type packs and multiple return values are preserved.
def identity<T, Rest...>(first: T, ...: Rest...) -> (T, Rest...):
  return first, ...
